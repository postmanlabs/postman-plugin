#!/bin/sh
# Prints the session-start mandate. hooks.json passes Droid's plugin root as $1 only on Droid. Only Cursor
# sets CURSOR_PLUGIN_ROOT and only Copilot CLI sets COPILOT_PLUGIN_ROOT; both read stdout only as JSON, under
# different keys. None of the three prefixes skills with `postman:`. session-start.cmd is this script for cmd.exe.
context="${0%/*}/session-start-context.md"
bare_names='s/`postman:\([a-z0-9-]*\)`/`\1`/g'
if [ -n "$1" ]; then
    sed "$bare_names" "$context"
elif [ -n "$CURSOR_PLUGIN_ROOT$COPILOT_PLUGIN_ROOT" ]; then
    key=additionalContext
    [ -z "$CURSOR_PLUGIN_ROOT" ] || key=additional_context
    tab=$(printf '\t') cr=$(printf '\r')
    text=$(sed -e "$bare_names" -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$tab/\\\\t/g" -e "s/$cr/\\\\r/g" -e 's/$/\\n/' "$context") || exit
    printf '{"%s":"%s"}' "$key" "$text" | tr -d '\n'
else
    cat "$context"
fi
