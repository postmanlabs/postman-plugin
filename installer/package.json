{
  "name": "@postman/postman-plugin",
  "version": "0.1.2",
  "description": "Postman's API engineering skills for coding agents: a Pi package, and an npx installer that sets up Claude Code, Codex, Cursor, Kimi Code, OpenCode and Pi.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Postman",
    "email": "postman-plugins@postman.com",
    "url": "https://github.com/postmanlabs"
  },
  "homepage": "https://github.com/postmanlabs/postman-plugin#install",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postmanlabs/postman-plugin.git",
    "directory": "installer"
  },
  "bugs": "https://github.com/postmanlabs/postman-plugin/issues",
  "keywords": [
    "pi-package",
    "pi",
    "postman",
    "claude-code",
    "codex",
    "cursor",
    "factory.ai",
    "kimi",
    "opencode",
    "agent-plugin"
  ],
  "bin": {
    "postman-plugin": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    "hooks/session-start-context.md",
    "mcp.pi.json"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://assets.getpostman.com/common-share/postman-logo-horizontal-320x132.png"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node scripts/pack-repo-files.js stage",
    "postpack": "node scripts/pack-repo-files.js clean",
    "test": "npm run build && node --test test/*.test.js",
    "test:pi-harness": "node scripts/pi-harness.js"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
