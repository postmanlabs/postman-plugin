# Stored with the line endings each shell needs; -text keeps checkouts and archives byte-identical to the blob.
# An eol= conversion here makes GitHub's tarball differ from the tree, which the Claude plugin directory rejects.
hooks/session-start -text
hooks/session-start.cmd -text
agent-plugin/hooks/session-start -text
agent-plugin/hooks/session-start.cmd -text
# agent-plugin/ copies skills/ and hooks/ (scripts/build-manifest.js), so diffs collapse them.
agent-plugin/skills/** linguist-generated=true
agent-plugin/hooks/** linguist-generated=true
agent-plugin/com.github.copilot/** linguist-generated=true
